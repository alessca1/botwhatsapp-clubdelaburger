APP_ENV=local
DATABASE_URL=sqlite:///./data/burger.db
# 32+ caracteres. Es la clave para entrar al panel (/panel).
ADMIN_TOKEN=
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DAILY_CAP=2000
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=
ZERNIO_WEBHOOK_SECRET=
# Mercado Pago Checkout Pro (opcional). Si falta el token o el secreto, el bot no ofrece pago online.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública del servicio para notification_url y back_urls.
PUBLIC_BASE_URL=https://clubdelaburger-whatsapp.onrender.com
# El local cobra recargo por tarjeta: el checkout muestra transferencia y saldo de Mercado Pago.
MP_EXCLUDE_CARDS=true
# Minutos de vigencia del link de pago.
MP_LINK_EXPIRES_MINUTES=60
# Identificador estable del número (texto libre, ej. club-2643179759).
WHATSAPP_PHONE_NUMBER_ID=club-2643179759
BOT_ENABLED=false
# Piloto: solo responde a estos números (dígitos, separados por coma). Vacío = todos.
DEMO_ALLOWLIST=
# Minutos que el bot se calla después de que alguien del local responde desde el celular o el panel.
HUMAN_PAUSE_MINUTES=5
